RunService.RenderStepped:Connect(function()
    local hue = (tick() % 5) / 5
    local rgbColor = Color3.fromHSV(hue, 1, 1)

    for _, stroke in ipairs(rgbStrokes) do stroke.Color = rgbColor end
    for _, btn in ipairs(rgbButtons) do btn.BackgroundColor3 = rgbColor end
    for _, fill in ipairs(rgbFills) do fill.BackgroundColor3 = rgbColor end
    for _, tBtn in ipairs(rgbToggles) do tBtn.BackgroundColor3 = rgbColor end
end)

