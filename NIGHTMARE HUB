local AURA_CONFIG = {
    Enabled = false,
    Range = 27,
    MaxAttacksPerSecond = 15,
    BurstSize = 2,
    ScanInterval = 0.5, -- Increased to reduce lag
    TargetPlayers = true,
    TargetNPCs = true,
}

local AttackRemote = nil
local isAuraRemoteEvent = false

local function findAttackRemote()
    local possiblePaths = {
        ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("ActionsSystem") and ReplicatedStorage.Systems.ActionsSystem.Network:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Combat") and ReplicatedStorage.Systems.Combat:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Combat") and ReplicatedStorage.Combat:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Game") and ReplicatedStorage.Game:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Remote") and ReplicatedStorage.Remote:FindFirstChild("Attack"),
    }
    for _, remote in ipairs(possiblePaths) do
        if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
            return remote
        end
    end
    local function deepScan(folder)
        for _, child in folder:GetChildren() do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                local lowerName = child.Name:lower()
                if lowerName:find("attack") or lowerName:find("combat") or lowerName:find("damage") or lowerName:find("hit") then
                    return child
                end
            end
            if child:IsA("Folder") or child:IsA("Model") then
                local found = deepScan(child)
                if found then return found end
            end
        end
        return nil
    end
    return deepScan(ReplicatedStorage)
end

AttackRemote = findAttackRemote()
if AttackRemote then
