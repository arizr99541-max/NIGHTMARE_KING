local EATER_CONFIG = {
    Enabled = false,
    EatsPerFrame = 2, -- Lowered to completely remove frame drops/lag
    MaxSlot = 36,
}

local ConsumeRemote = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("ActionsSystem") and ReplicatedStorage.Systems.ActionsSystem:FindFirstChild("Network") and ReplicatedStorage.Systems.ActionsSystem.Network:FindFirstChild("Consume")
local slotIndex = 1
local eaterConnection = nil
local currentEatsPerSec = 0
local speedCounter = 0
local speedTimer = 0

-- Neutralize Fall Damage & Environment Damage via Dummy Trick (Lag-Free)
pcall(function()
    local combatNetwork = ReplicatedStorage:WaitForChild("Systems"):WaitForChild("CombatSystem"):WaitForChild("Network")
    local function nullifyRemote(remoteName)
        local realRemote = combatNetwork:FindFirstChild(remoteName)
        if realRemote then
            local dummy = Instance.new("RemoteEvent")
            dummy.Name = remoteName
            dummy.Parent = combatNetwork
            realRemote:Destroy()
        end
    end
    nullifyRemote("FallDamage")
    nullifyRemote("DrownDamage")
    nullifyRemote("EnteredLava")
end)

local function ResetEat()
    slotIndex = 1
end

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local hum = char.Humanoid
        if hum.MaxHealth ~= 100 then hum.MaxHealth = 100 end
        if hum.Health < 100 then hum.Health = 100 end
    end
end)

local function OptimizedEat()
    if not EATER_CONFIG.Enabled or not ConsumeRemote then return end
    for i = 1, EATER_CONFIG.EatsPerFrame do
        local slot = slotIndex
        task.spawn(function()
            pcall(function()
                ConsumeRemote:InvokeServer(slot)
            end)
        end)
        speedCounter = speedCounter + 1
        slotIndex = slotIndex + 1
        if slotIndex > EATER_CONFIG.MaxSlot then
            slotIndex = 1
        end
    end

    speedTimer = speedTimer + 1
    if speedTimer >= 30 then
        currentEatsPerSec = speedCounter * 2
        speedCounter = 0
        speedTimer = 0
    end
end

